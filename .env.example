# Flask Environment Configuration
# Copy this file to .env and update with your actual values

# Flask Environment (development/production/testing)
FLASK_ENV=development

# Security - Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here-generate-a-secure-one

# Database Configuration
# For SQLite (development): sqlite:///tas_erp.db
# For MySQL: mysql+pymysql://username:password@localhost:3306/database_name
# For PostgreSQL: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=sqlite:///tas_erp.db

# Database Passwords (for Docker deployment)
DB_ROOT_PASSWORD=your-root-password-here
DB_PASSWORD=your-database-password-here

# Server Configuration
PORT=8000
GUNICORN_WORKERS=4
LOG_LEVEL=info

# SSL Certificates (optional, for HTTPS)
SSL_KEYFILE=
SSL_CERTFILE=

# Upload Settings (optional overrides)
# MAX_CONTENT_LENGTH=10485760  # 10MB in bytes
# UPLOAD_FOLDER=app/static/uploads

# Session Settings (optional overrides)
# PERMANENT_SESSION_LIFETIME=3600  # 1 hour in seconds
